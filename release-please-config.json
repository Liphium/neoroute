{
	"tag-separator": "/",
	"separate-pull-requests": true,
	"packages": {
		".": {
			"release-type": "go",
			"include-v-in-tag": true,
			"exclude-paths": ["client", "transporter", "examples", "pkg"]
		},
		"client/sdk": {
			"release-type": "go",
			"include-v-in-tag": true,
			"component": "client/sdk"
		},
		"client/transporter/http": {
			"release-type": "go",
			"include-v-in-tag": true,
			"component": "client/transporter/http"
		},
		"client/transporter/websocket": {
			"release-type": "go",
			"include-v-in-tag": true,
			"component": "client/transporter/websocket"
		},
		"transporter/http": {
			"release-type": "go",
			"include-v-in-tag": true,
			"component": "transporter/http"
		},
		"transporter/websocket": {
			"release-type": "go",
			"include-v-in-tag": true,
			"component": "transporter/websocket"
		},
		"pkg/neodebug": {
			"release-type": "go",
			"include-v-in-tag": true,
			"component": "pkg/neodebug"
		}
	}
}
